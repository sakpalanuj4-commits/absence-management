# Copy to .env and fill in.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=Europe/London

# Database - MySQL is the default. Set DB_ENGINE=sqlite to run without a
# MySQL server (useful on a laptop or in CI).
DB_ENGINE=mysql
DB_NAME=absence_management
DB_USER=absence_user
DB_PASSWORD=your-password
DB_HOST=127.0.0.1
DB_PORT=3306

# Email - the console backend prints messages to the terminal in development.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@absence-management.local

SESSION_TIMEOUT_MINUTES=60
